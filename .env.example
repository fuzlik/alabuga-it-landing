DATABASE_URL=postgresql://alabuga:alabuga@127.0.0.1:5433/alabuga_it
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173

# Ссылка на политику конфиденциальности (футер и форма)
VITE_PRIVACY_POLICY_URL=https://startrussia.alabuga.ru/policy.html

# Ссылка на карты для адреса офиса (по умолчанию — Яндекс.Карты)
# VITE_OFFICE_MAPS_URL=https://yandex.ru/maps/?text=...

# --- Bitrix24 (необязательно) ---
# Входящий webhook: Разработчикам → Другое → Входящий webhook
# Права: crm (обязательно), disk — если будете грузить файлы отдельно
# Пример: https://your-company.bitrix24.ru/rest/1/abc123xyz/
BITRIX24_WEBHOOK_URL=

# Заголовок лида в CRM
BITRIX24_LEAD_TITLE=Заявка — Алабуга IT

# Источник в Bitrix24 (WEB, CALL, EMAIL и т.д.)
BITRIX24_SOURCE_ID=WEB

# ID ответственного менеджера (необязательно)
# BITRIX24_ASSIGNED_BY_ID=1

# Код пользовательского поля для ссылки на портфолио (необязательно)
# Пример: UF_CRM_1234567890
# BITRIX24_PORTFOLIO_FIELD=

# Код пользовательского поля типа «Файл» для резюме (необязательно)
# Если не задано — имя файла попадёт только в комментарий лида
# BITRIX24_RESUME_FIELD=

# Telegram-бот заявок (необязательно)
TELEGRAM_BOT_URL=http://127.0.0.1:8080/api/applications
TELEGRAM_BOT_API_KEY=alabuga-it-landing
